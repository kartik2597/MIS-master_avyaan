APP_PROJECT_NAME="MIS Master 2.O"
APP_ENVIRONMENT=development
APP_DEBUG=true

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mis_master

APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
# How long a login can be renewed without typing the password again.
APP_REFRESH_TOKEN_EXPIRE_DAYS=7

APP_LOG_LEVEL=INFO
APP_STORAGE_DIR=storage
APP_MAX_UPLOAD_SIZE_MB=25

# Import an ADMIN/MIS upload as soon as it passes validation (no manual "Process" step).
APP_AUTO_PROCESS_UPLOADS=true

# Comma-separated list of allowed browser origins (add your LAN/prod URL here).
APP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
